diff --git a/meson.build b/meson.build
--- a/meson.build
+++ b/meson.build
@@ -117,11 +117,24 @@ use_doctest = get_option('doctest')
 use_launcher = get_option('launcher')
 if use_launcher
+        system_uid_max = '999'
